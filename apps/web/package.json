    "drizzle-kit": "^0.27.0",
    "drizzle-orm": "^0.31.0",
    "h3": "^1.12.0",
    "libsql": "^0.3.17",
    "nuxt": "^4.0.0",
    "pinia": "^2.1.7",
    "std-env": "^3.7.0",
    "uuid": "^9.0.1",
